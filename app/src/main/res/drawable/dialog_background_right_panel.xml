<?xml version="1.0" encoding="utf-8"?>
<!-- 贴右面板底（选集/画质/倍速等）：结构同 dialog_background，只圆左侧两角，
     底图 / 底色 / 描边三者叠放顺序一致 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/thirdBackgroundColor" />
            <corners
                android:topLeftRadius="@dimen/px20"
                android:bottomLeftRadius="@dimen/px20"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item android:drawable="?attr/dialogCardImage" />
    <item>
        <shape>
            <stroke android:width="@dimen/px2" android:color="?attr/buttonStrokeColor" />
            <corners
                android:topLeftRadius="@dimen/px20"
                android:bottomLeftRadius="@dimen/px20"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
