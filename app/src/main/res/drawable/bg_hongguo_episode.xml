<?xml version="1.0" encoding="utf-8"?>
<!-- 红果详情选集格（正在看=选中态）：状态集与全 App 通用按钮（tab_round_background，侧栏功能钮）完全同序同色——
     点击=colorPrimary、激活(聚焦)=colorControlHighlight、选中=tabBarHighlight、常态=?attr/buttonBackgroundColor；
     圆角保留 px15（格子形态，非侧栏圆形）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@android:integer/config_shortAnimTime">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorPrimary"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/colorControlHighlight"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/tabBarHighlight"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/buttonBackgroundColor"/>
            <!-- 常态描边出框：黑主题弹窗底(#454545)与格子底(#444444)肉眼无法区分
                 （2026-11-28 用户反馈），中性灰描边黑白两主题都可见 -->
            <stroke android:width="@dimen/px2" android:color="?attr/buttonStrokeColor"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
</selector>
