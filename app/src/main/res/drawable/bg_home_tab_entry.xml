<?xml version="1.0" encoding="utf-8"?>
<!-- 首页页签排序行三态（与控制条排序行同款观感）：activated=移动中（accent 描边）、
     selected/pressed=选中或触摸按下（中性亮底）、常态透明。
     键盘交互不依赖系统焦点，行状态由 isSelected/isActivated 驱动。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="#33FB7299" />
            <stroke android:width="@dimen/px3" android:color="?attr/colorAccent" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/colorControlHighlight" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorControlHighlight" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
</selector>
