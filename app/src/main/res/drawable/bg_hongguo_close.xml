<?xml version="1.0" encoding="utf-8"?>
<!-- 登录弹窗右上关闭钮（设计稿 dlg-head .x）：描边圆角钮，聚焦=白描边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hongguo_card_face_focused"/>
            <stroke android:width="@dimen/px3" android:color="@color/white"/>
            <corners android:radius="@dimen/px8"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="@color/hongguo_card_line"/>
            <corners android:radius="@dimen/px8"/>
        </shape>
    </item>
</selector>
