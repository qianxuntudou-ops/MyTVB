<?xml version="1.0" encoding="utf-8"?>
<!-- 红果统一 TV 分段控件态（2026-11-11 B 站风格统一：与 App 组件同语言）：
     选中=主题强调色实底+深字；聚焦=整块 colorControlHighlight 提亮（同 button_common/
     bg_hongguo_page_chip，弃白描边内衬）；选中+聚焦=实底保持；按下=colorPrimary；
     禁用=置灰（倒计时/无权限）。圆角对齐 App 按钮主力档 px15。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@android:integer/config_shortAnimTime">

    <item android:state_enabled="false">
        <shape>
            <solid android:color="#131317"/>
            <stroke android:width="1dp" android:color="#2A2A31"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <!-- 选中（含聚焦叠加）：强调色实底保持，字色由代码控制 -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/colorAccent"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorPrimary"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/colorControlHighlight"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/hongguo_card_face"/>
            <stroke android:width="1dp" android:color="@color/hongguo_card_line"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
</selector>
