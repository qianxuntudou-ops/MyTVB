<?xml version="1.0" encoding="utf-8"?>
<!-- 红果统一 TV 分段控件态（2026-11-12 选中色对齐侧栏）：
     选中=?attr/tabBarHighlight（侧栏当前 tab 同款强调 attr，弃 colorAccent——浅紫底白字
     对比不足被用户否决）；聚焦=整块 colorControlHighlight 半透明主题色提亮（全 App 统一
     聚焦语言）；按下=colorPrimary；禁用=置灰。圆角 px15。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@android:integer/config_shortAnimTime">

    <item android:state_enabled="false">
        <shape>
            <solid android:color="#131317"/>
            <stroke android:width="1dp" android:color="#2A2A31"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <!-- 选中（含聚焦叠加）：侧栏选中同款强调色，字色由代码控制（白） -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/tabBarHighlight"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorPrimary"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/colorControlHighlight"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/hongguo_card_face"/>
            <stroke android:width="1dp" android:color="@color/hongguo_card_line"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
</selector>
