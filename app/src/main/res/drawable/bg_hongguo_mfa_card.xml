<?xml version="1.0" encoding="utf-8"?>
<!-- MFA 短信上行指引提示卡（2026-11-11 B 站风格统一，对齐 chip 选中语言）：
     主题强调色 15% 浅底 + 40% 描边（layer-list item alpha，API23+），圆角 px15。
     卡本身不可聚焦，无聚焦态分支（聚焦落在卡内「我已发送」主钮上）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/hongguo_card_face"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
    <item android:alpha="0.15">
        <shape>
            <solid android:color="?attr/colorAccent"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
    <item android:alpha="0.40">
        <shape>
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="?attr/colorAccent"/>
            <corners android:radius="@dimen/px15"/>
        </shape>
    </item>
</layer-list>
