<?xml version="1.0" encoding="utf-8"?>
<!-- 红果登录弹窗粘贴框（2026-11-20 重设计·对齐搜索页配色口径）：
     底/描边与 bg_search_input 同源（?attr/buttonBackgroundColor + dividerColor），
     虚线表达"可粘贴区"；聚焦=主题强调色虚线。圆角 px22 与搜索输入框一致。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/buttonBackgroundColor"/>
            <stroke
                android:width="@dimen/px2"
                android:color="?attr/colorAccent"
                android:dashWidth="@dimen/px6"
                android:dashGap="@dimen/px5"/>
            <corners android:radius="@dimen/px22"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/buttonBackgroundColor"/>
            <stroke
                android:width="@dimen/px2"
                android:color="?attr/dividerColor"
                android:dashWidth="@dimen/px6"
                android:dashGap="@dimen/px5"/>
            <corners android:radius="@dimen/px22"/>
        </shape>
    </item>
</selector>
