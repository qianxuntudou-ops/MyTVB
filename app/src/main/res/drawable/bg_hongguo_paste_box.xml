<?xml version="1.0" encoding="utf-8"?>
<!-- 红果登录弹窗虚线粘贴框（2026-11-11 B 站风格统一）：
     聚焦=主题强调色虚线（B 站聚焦语言）；非聚焦=#5A5A64 虚线（1dp/#3A3A44 在弹窗
     暗底上断续不可见）；暗底强化框存在感。圆角对齐全 App 输入框 px22。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D0D10"/>
            <stroke
                android:width="@dimen/px2"
                android:color="?attr/colorAccent"
                android:dashWidth="@dimen/px6"
                android:dashGap="@dimen/px5"/>
            <corners android:radius="@dimen/px22"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D10"/>
            <stroke
                android:width="@dimen/px2"
                android:color="#5A5A64"
                android:dashWidth="@dimen/px6"
                android:dashGap="@dimen/px5"/>
            <corners android:radius="@dimen/px22"/>
        </shape>
    </item>
</selector>
