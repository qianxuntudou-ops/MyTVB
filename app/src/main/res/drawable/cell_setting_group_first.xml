<?xml version="1.0" encoding="utf-8"?>
<!-- 组框首行：上圆角下直角（与 cell_setting_background 同配色，组内条目贴合拼接为一框） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@android:integer/config_shortAnimTime">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorPrimary"/>
            <corners android:topLeftRadius="@dimen/px15" android:topRightRadius="@dimen/px15"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="?attr/thirdBackgroundColor"/>
                    <corners android:topLeftRadius="@dimen/px15" android:topRightRadius="@dimen/px15"/>
                </shape>
            </item>
            <item android:left="@dimen/px8" android:top="@dimen/px14">
                <shape>
                    <solid android:color="?attr/colorPrimary"/>
                    <corners android:radius="@dimen/px6"/>
                    <size android:width="@dimen/px6"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/subBackgroundColor"/>
            <corners android:topLeftRadius="@dimen/px15" android:topRightRadius="@dimen/px15"/>
            <stroke android:width="@dimen/px2" android:color="?attr/dividerColor"/>
        </shape>
    </item>
</selector>
