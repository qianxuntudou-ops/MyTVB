<?xml version="1.0" encoding="utf-8"?>
<!-- 首页页签弹窗「确认」按钮：键盘选中（selected）=中性亮底（同排序行选中色），
     pressed=colorPrimary，常态淡灰底（同 bg_hongguo_btn_detail 常态）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/fourthBackgroundColor" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/buttonBackgroundColor" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
</selector>
