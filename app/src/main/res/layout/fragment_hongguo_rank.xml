<?xml version="1.0" encoding="utf-8"?>
<!-- 红果榜单页（2026-11-11 重设计）：四板换统一分段控件（HongguoSegmentedTabs，
     替代原生 RadioButton）+ 右侧说明行；网格/骨架/空态三态互斥。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.mytvb.feature.hongguo.HongguoSegmentedTabs
            android:id="@+id/segment_rank_boards"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_rank_note"
            android:text="@string/hongguo_rank_note"
            android:textSize="@dimen/px20"
            android:textColor="@color/grey"
            android:layout_marginStart="@dimen/px24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rank"
            android:padding="@dimen/px20"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <include
            android:id="@+id/skeleton_rank"
            layout="@layout/view_hongguo_skeleton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <include
            android:id="@+id/empty_rank"
            layout="@layout/view_hongguo_empty"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
