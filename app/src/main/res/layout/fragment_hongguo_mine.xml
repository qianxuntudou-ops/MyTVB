<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/px40"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:src="@drawable/ic_hongguo"
        app:tint="?attr/colorAccent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:padding="@dimen/px20"
        android:layout_width="@dimen/px140"
        android:layout_height="@dimen/px140"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_nickname"
        android:text="@string/hongguo_not_logged_in"
        android:textSize="@dimen/px32"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginTop="@dimen/px16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_stats"
        android:textSize="@dimen/px22"
        android:textColor="@color/grey"
        android:layout_marginTop="@dimen/px10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_login"
        android:text="@string/hongguo_login"
        android:textSize="@dimen/px26"
        android:textColor="@color/white"
        android:background="@drawable/hongguo_btn_play"
        android:paddingStart="@dimen/px60"
        android:paddingEnd="@dimen/px60"
        android:layout_marginTop="@dimen/px30"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px70"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_clear"
        android:text="@string/hongguo_clear_local"
        android:textSize="@dimen/px24"
        android:textColor="@color/grey"
        android:background="@drawable/tab_round_background"
        android:paddingStart="@dimen/px40"
        android:paddingEnd="@dimen/px40"
        android:layout_marginTop="@dimen/px20"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px60"/>
</LinearLayout>
