<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <!-- 顶栏：退出 + 清晰度 + 时钟（组件与观感对齐 B 站 my_player_control_view 顶栏） -->
    <LinearLayout
        android:id="@+id/panel_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/hongguo_cover_bottom_shade"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px16"
        android:paddingBottom="@dimen/px16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.mytvb.feature.player.view.PlayerControlButton
            android:id="@+id/button_exit"
            android:background="@drawable/cell_background"
            android:padding="@dimen/px18"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusDown="@id/time_bar"
            android:layout_width="@dimen/px80"
            android:layout_height="@dimen/px80"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"/>
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/px1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_quality"
            android:textSize="@dimen/px22"
            android:textColor="#FFB28F"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/px12"
            android:paddingEnd="@dimen/px12"
            android:paddingTop="@dimen/px8"
            android:paddingBottom="@dimen/px8"
            android:layout_marginEnd="@dimen/px8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextClock
            android:textSize="@dimen/px50"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/black"
            android:shadowRadius="7"/>
    </LinearLayout>
    <!-- 底栏：标题 + 进度条 + 播放/暂停/快退/快进 + 时间（对齐 B 站 exo_bottom_bar 结构） -->
    <LinearLayout
        android:id="@+id/panel_bottom"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@drawable/focus_background"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px24"
        android:paddingBottom="@dimen/px30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            android:textSize="@dimen/px40"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:shadowColor="@color/black"
            android:shadowDx="1.5"
            android:shadowDy="1.3"
            android:shadowRadius="1.6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.mytvb.feature.player.view.DefaultTimeBar
            android:id="@+id/time_bar"
            android:nextFocusDown="@+id/button_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px5"
            app:bar_height="@dimen/px6"
            app:played_color="#E6FB7299"
            app:unplayed_color="#40FFFFFF"
            app:scrubber_drawable="@drawable/ic_progress_head"
            app:scrubber_dragged_size="46dp"
            app:scrubber_focus_peak_size="54dp"
            app:scrubber_enabled_size="34dp"
            app:touch_target_height="60dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.mytvb.feature.player.view.PlayerControlButton
                android:id="@+id/button_play"
                android:background="@drawable/cell_background"
                android:padding="@dimen/px32"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/time_bar"
                android:layout_width="@dimen/px113"
                android:layout_height="@dimen/px113"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/play_pause">
                <requestFocus/>
            </com.mytvb.feature.player.view.PlayerControlButton>
            <!-- 画质/选集/倍速：各开右侧竖版面板（HongguoRightPanelDialog） -->
            <com.mytvb.feature.player.view.PlayerControlButton
                android:id="@+id/button_quality"
                android:background="@drawable/cell_background"
                android:padding="@dimen/px32"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/time_bar"
                android:layout_marginStart="@dimen/px10"
                android:layout_width="@dimen/px113"
                android:layout_height="@dimen/px113"
                android:src="@drawable/ic_player_setting"
                android:contentDescription="@string/video_quality"/>
            <com.mytvb.feature.player.view.PlayerControlButton
                android:id="@+id/button_episodes"
                android:background="@drawable/cell_background"
                android:padding="@dimen/px32"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/time_bar"
                android:layout_marginStart="@dimen/px10"
                android:layout_width="@dimen/px113"
                android:layout_height="@dimen/px113"
                android:src="@drawable/ic_list"
                android:contentDescription="@string/choose_episode"/>
            <com.mytvb.feature.player.view.PlayerControlButton
                android:id="@+id/button_speed"
                android:background="@drawable/cell_background"
                android:padding="@dimen/px32"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/time_bar"
                android:layout_marginStart="@dimen/px10"
                android:layout_width="@dimen/px113"
                android:layout_height="@dimen/px113"
                android:src="@drawable/exo_ic_speed"
                android:contentDescription="@string/playSpeed"/>
            <!-- 快退/快进按钮已按需求隐藏（遥控左右键与触摸滑动可完成快进快退） -->
            <com.mytvb.feature.player.view.PlayerControlButton
                android:id="@+id/button_rewind"
                android:visibility="gone"
                android:background="@drawable/cell_background"
                android:padding="@dimen/px32"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/time_bar"
                android:layout_marginStart="@dimen/px10"
                android:layout_width="@dimen/px113"
                android:layout_height="@dimen/px113"
                android:src="@drawable/ic_rewind"
                android:contentDescription="@string/rewind"/>
            <com.mytvb.feature.player.view.PlayerControlButton
                android:id="@+id/button_fast_forward"
                android:visibility="gone"
                android:background="@drawable/cell_background"
                android:padding="@dimen/px32"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/time_bar"
                android:layout_width="@dimen/px113"
                android:layout_height="@dimen/px113"
                android:src="@drawable/ic_fast_forward"
                android:contentDescription="@string/fast_forward"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/px1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingStart="@dimen/px10"
                android:paddingEnd="@dimen/px10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_position"
                    android:textSize="@dimen/px35"
                    android:textColor="@color/exo_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/px35"
                    android:textColor="@color/exo_white_opacity_70"
                    android:text="·"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_duration"
                    android:textSize="@dimen/px35"
                    android:textColor="@color/exo_white_opacity_70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- 常驻时钟：「时间常驻显示」开关打开时，控制栏隐藏期间右上角显示（B站 setAlwaysOnClock 同款） -->
    <TextClock
        android:id="@+id/text_clock_always"
        android:textSize="@dimen/px50"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/px16"
        android:layout_marginEnd="@dimen/px30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="@color/black"
        android:shadowRadius="7"
        android:visibility="gone"/>
    <!-- 暂停大图标：暂停+控制栏隐藏时右下角定格提示（尺寸/边距/透明度全套对齐 B 站 image_pause_indicator） -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_pause_big"
        android:src="@drawable/ic_pause_new"
        android:alpha="0.9"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/px90"
        android:layout_marginBottom="@dimen/px169"
        android:layout_width="@dimen/px135"
        android:layout_height="@dimen/px135"
        android:importantForAccessibility="no"
        android:visibility="gone"/>
    <!-- 中央快进/快退提示（短按累积 Xs / 长按推进反馈，对齐 B 站 SeekOverlayView 文字提示） -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_seek_hint"
        android:textSize="@dimen/px40"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:shadowColor="@color/black"
        android:shadowRadius="5"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>
    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_width="@dimen/px70"
        android:layout_height="@dimen/px70"/>
</FrameLayout>
