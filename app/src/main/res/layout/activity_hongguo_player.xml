<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/panel_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/hongguo_cover_bottom_shade"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px16"
        android:paddingBottom="@dimen/px16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            android:textSize="@dimen/px28"
            android:textColor="@color/white"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_quality"
            android:textSize="@dimen/px22"
            android:textColor="#FFB28F"
            android:layout_marginStart="@dimen/px20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/panel_bottom"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@drawable/player_top_gradient"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px24"
        android:paddingBottom="@dimen/px24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/time_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/px10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_position"
                android:textSize="@dimen/px22"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/px1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_duration"
                android:textSize="@dimen/px22"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_width="@dimen/px70"
        android:layout_height="@dimen/px70"/>
</FrameLayout>
