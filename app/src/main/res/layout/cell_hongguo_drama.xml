<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/px8">
    <LinearLayout
        android:id="@+id/cell_root"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_cover"
                android:scaleType="centerCrop"
                android:layout_width="match_parent"
                android:layout_height="@dimen/px180"
                android:background="@color/black"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_badge_season"
                android:textSize="@dimen/px18"
                android:textColor="@color/white"
                android:background="#99000000"
                android:paddingStart="@dimen/px8"
                android:paddingEnd="@dimen/px8"
                android:paddingTop="@dimen/px2"
                android:paddingBottom="@dimen/px2"
                android:layout_gravity="top|end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/hongguo_cover_bottom_shade"
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/px8"
                android:paddingEnd="@dimen/px8"
                android:paddingTop="@dimen/px18"
                android:paddingBottom="@dimen/px4"
                android:gravity="center_vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_heat"
                    android:textSize="@dimen/px18"
                    android:textColor="#FFB28F"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_episodes"
                    android:textSize="@dimen/px18"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            android:textSize="@dimen/px22"
            android:textColor="?android:attr/textColorPrimary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/px6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_tags"
            android:textSize="@dimen/px18"
            android:textColor="@color/grey"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
