<?xml version="1.0" encoding="utf-8"?>
<!-- 红果剧卡片长按菜单：样式对齐 dialog_video_card_menu（标题+副标题+图标按钮行），
     仅两项（创作者/相关作品），无滚动需求，不带 menu_scroll。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:paddingStart="@dimen/px20"
    android:paddingTop="@dimen/px20"
    android:paddingEnd="@dimen/px20"
    android:paddingBottom="@dimen/px20">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/textColor"
        android:textSize="@dimen/px30"
        android:textStyle="bold" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px6"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hongguo_menu_subtitle"
            android:textColor="@color/subTextColor"
            android:textSize="@dimen/px20" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/px2"
            android:layout_marginTop="@dimen/px8"
            android:background="@color/fourthBackgroundColor" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/button_creator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px6"
        android:background="@drawable/bg_menu_button"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusDown="@id/button_related"
        android:gravity="center_vertical"
        android:minHeight="@dimen/px64"
        android:orientation="horizontal"
        android:paddingStart="@dimen/px12"
        android:paddingTop="@dimen/px6"
        android:paddingEnd="@dimen/px12"
        android:paddingBottom="@dimen/px6">

        <FrameLayout
            android:layout_width="@dimen/px52"
            android:layout_height="@dimen/px52"
            android:background="@drawable/dialog_menu_icon_background">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/px30"
                android:layout_height="@dimen/px30"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_user"
                app:tint="@color/textColor" />
        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px12"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/hongguo_menu_creator"
                android:textColor="@color/textColor"
                android:textSize="@dimen/px26"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_creator_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/px4"
                android:text="@string/hongguo_menu_creator_summary"
                android:textColor="@color/subTextColor"
                android:textSize="@dimen/px18" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/button_related"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px2"
        android:background="@drawable/bg_menu_button"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusUp="@id/button_creator"
        android:gravity="center_vertical"
        android:minHeight="@dimen/px64"
        android:orientation="horizontal"
        android:paddingStart="@dimen/px12"
        android:paddingTop="@dimen/px6"
        android:paddingEnd="@dimen/px12"
        android:paddingBottom="@dimen/px6">

        <FrameLayout
            android:layout_width="@dimen/px52"
            android:layout_height="@dimen/px52"
            android:background="@drawable/dialog_menu_icon_background">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/px30"
                android:layout_height="@dimen/px30"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_list"
                app:tint="@color/textColor" />
        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px12"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/hongguo_menu_related"
                android:textColor="@color/textColor"
                android:textSize="@dimen/px26"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/px4"
                android:text="@string/hongguo_menu_related_summary"
                android:textColor="@color/subTextColor"
                android:textSize="@dimen/px18" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
