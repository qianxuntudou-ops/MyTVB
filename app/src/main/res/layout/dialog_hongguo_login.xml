<?xml version="1.0" encoding="utf-8"?>
<!-- 红果登录弹窗（2026-11-20 重设计·统一 App 既有设计语言，不引入任何专属品牌色）：
     单层深色壳 bg_hongguo_login_shell(subBackgroundColor #232323)：全局弹窗壳
     thirdBackgroundColor(#454545) 与按钮默认底几乎同色会把灰底按钮吃掉；
     标题行=「登录红果账号」+右上关闭钮（AppCompatImageView+cell_background+ic_close，
     与章节列表/评论面板同款）；通道切换=与主界面顶层 tab 同款的下划线页签；
     扫码=左 px300 白底二维码卡+右侧四级信息（标题/状态/有效期/刷新钮）；
     短信=px560 居中窄列（输入框 px60 + 内嵌发送钮 + MFA 提示行 + 全宽登录钮）；
     导入=虚线粘贴框+说明+全宽主钮。焦点链：页签⇄右上关闭钮、页签↓各面板首控件。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_hongguo_login_shell"
    android:clickable="true"
    android:paddingStart="@dimen/px36"
    android:paddingTop="@dimen/px30"
    android:paddingEnd="@dimen/px36"
    android:paddingBottom="@dimen/px22"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 标题行 + 关闭钮 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:text="@string/hongguo_login"
            android:textSize="@dimen/px36"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <!-- 关闭钮：与其它弹窗（章节列表/评论面板）同款——AppCompatImageView
             + cell_background + ic_close（ic_close 本身是白色 X，不要再套白描边底，
             否则会渲染成一个白方块） -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_login_close"
            android:src="@drawable/ic_close"
            android:background="@drawable/cell_background"
            android:padding="@dimen/px12"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:layout_width="@dimen/px56"
            android:layout_height="@dimen/px56"/>
    </LinearLayout>

    <!-- 通道页签：下划线式（主界面顶层 tab 同款）。焦点态学习首页 tab：
         焦点落在文字 TextView 自己身上，tab_item_round_background 直接给出
         colorControlHighlight 提亮 + accent px3 描边；指示条在文字块下方、仅选中项显示 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/px14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tab_qr"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/tab_item_round_background"
                android:paddingStart="@dimen/px20"
                android:paddingTop="@dimen/px6"
                android:paddingEnd="@dimen/px20"
                android:paddingBottom="@dimen/px6"
                android:text="@string/hongguo_login_qr"
                android:textSize="@dimen/px28"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <View
                android:id="@+id/ind_qr"
                android:background="@drawable/bg_hongguo_login_tab_indicator"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/px8"
                android:visibility="visible"
                android:layout_width="@dimen/px48"
                android:layout_height="@dimen/px8"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="@dimen/px20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tab_sms"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/tab_item_round_background"
                android:paddingStart="@dimen/px20"
                android:paddingTop="@dimen/px6"
                android:paddingEnd="@dimen/px20"
                android:paddingBottom="@dimen/px6"
                android:text="@string/hongguo_login_sms"
                android:textSize="@dimen/px28"
                android:textColor="@color/tab_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <View
                android:id="@+id/ind_sms"
                android:background="@drawable/bg_hongguo_login_tab_indicator"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/px8"
                android:visibility="invisible"
                android:layout_width="@dimen/px48"
                android:layout_height="@dimen/px8"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="@dimen/px20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tab_import"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/tab_item_round_background"
                android:paddingStart="@dimen/px20"
                android:paddingTop="@dimen/px6"
                android:paddingEnd="@dimen/px20"
                android:paddingBottom="@dimen/px6"
                android:text="@string/hongguo_login_import"
                android:textSize="@dimen/px28"
                android:textColor="@color/tab_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <View
                android:id="@+id/ind_import"
                android:background="@drawable/bg_hongguo_login_tab_indicator"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/px8"
                android:visibility="invisible"
                android:layout_width="@dimen/px48"
                android:layout_height="@dimen/px8"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 页签行下分割线 -->
    <View
        android:background="?attr/dividerColor"
        android:layout_marginTop="@dimen/px14"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <!-- 内容区：单层深色壳上直接排布（不再套第二层卡）；三通道共用固定高度，
         切换页签时窗口不跳 -->
    <FrameLayout
        android:id="@+id/panel_host"
        android:padding="@dimen/px20"
        android:layout_marginTop="@dimen/px20"
        android:layout_width="match_parent"
        android:layout_height="@dimen/px360">

        <!-- 扫码：左白底二维码卡 + 右侧信息列 -->
        <LinearLayout
            android:id="@+id/panel_qr"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_qr"
                android:background="@drawable/bg_hongguo_qr_card"
                android:padding="@dimen/px16"
                android:layout_width="@dimen/px300"
                android:layout_height="@dimen/px300"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="@dimen/px36"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:text="@string/hongguo_qr_scan_title"
                    android:textSize="@dimen/px30"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_qr_status"
                    android:text="@string/hongguo_qr_wait_scan"
                    android:textSize="@dimen/px24"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginTop="@dimen/px12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_qr_ttl"
                    android:text="@string/hongguo_qr_ttl"
                    android:textSize="@dimen/px24"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="@dimen/px8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_qr_refresh"
                    android:text="@string/hongguo_qr_refresh"
                    android:textSize="@dimen/px28"
                    android:textColor="@color/hongguo_neutral_btn_text"
                    android:background="@drawable/bg_hongguo_btn_detail"
                    android:paddingStart="@dimen/px26"
                    android:paddingEnd="@dimen/px26"
                    android:layout_marginTop="@dimen/px24"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/px56"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 短信：居中窄列 -->
        <LinearLayout
            android:id="@+id/panel_sms"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="@dimen/px560"
            android:layout_height="wrap_content">

            <!-- 手机号（无 label，占位提示，减一层视觉噪音） -->
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_phone"
                android:background="@drawable/bg_search_input"
                android:focusable="true"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:hint="@string/hongguo_phone_hint"
                android:textSize="@dimen/px26"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:paddingStart="@dimen/px22"
                android:paddingEnd="@dimen/px22"
                android:layout_width="match_parent"
                android:layout_height="@dimen/px64"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/px14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_sms_code"
                    android:background="@drawable/bg_search_input"
                    android:focusable="true"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:hint="@string/hongguo_code_hint"
                    android:textSize="@dimen/px26"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:paddingStart="@dimen/px22"
                    android:paddingEnd="@dimen/px22"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/px64"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_send_code"
                    android:text="@string/hongguo_send_code"
                    android:textSize="@dimen/px24"
                    android:textColor="@color/hongguo_neutral_btn_text"
                    android:background="@drawable/bg_hongguo_btn_detail"
                    android:paddingStart="@dimen/px18"
                    android:paddingEnd="@dimen/px18"
                    android:layout_marginStart="@dimen/px12"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/px52"/>
            </LinearLayout>

            <!-- MFA 短信上行指引：左侧强调色细条 + 一行指引 + 次行动钮 -->
            <LinearLayout
                android:id="@+id/card_mfa"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_hongguo_mfa_card"
                android:paddingStart="@dimen/px16"
                android:paddingTop="@dimen/px12"
                android:paddingEnd="@dimen/px16"
                android:paddingBottom="@dimen/px12"
                android:layout_marginTop="@dimen/px14"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:src="@drawable/ic_hongguo_mfa_shield"
                    app:tint="?attr/colorAccent"
                    android:layout_width="@dimen/px28"
                    android:layout_height="@dimen/px28"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_mfa_tip"
                    android:textSize="@dimen/px24"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginStart="@dimen/px12"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_mfa_sent"
                    android:text="@string/hongguo_mfa_sent"
                    android:textSize="@dimen/px24"
                    android:textColor="@color/hongguo_neutral_btn_text"
                    android:background="@drawable/bg_hongguo_btn_detail"
                    android:paddingStart="@dimen/px18"
                    android:paddingEnd="@dimen/px18"
                    android:layout_marginStart="@dimen/px12"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/px52"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_sms_login"
                android:text="@string/hongguo_sms_login"
                android:textSize="@dimen/px28"
                android:textColor="@color/hongguo_neutral_btn_text"
                android:background="@drawable/bg_hongguo_btn_primary"
                android:layout_marginTop="@dimen/px14"
                android:layout_width="match_parent"
                android:layout_height="@dimen/px64"/>
        </LinearLayout>

        <!-- 导入：通栏虚线粘贴框 + 格式说明 + 主行动钮 -->
        <LinearLayout
            android:id="@+id/panel_import"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_import"
                android:background="@drawable/bg_hongguo_paste_box"
                android:layerType="software"
                android:focusable="true"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                android:hint="@string/hongguo_login_import_hint"
                android:fontFamily="monospace"
                android:textSize="@dimen/px22"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:gravity="top"
                android:paddingStart="@dimen/px20"
                android:paddingTop="@dimen/px16"
                android:paddingEnd="@dimen/px20"
                android:paddingBottom="@dimen/px16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/px180"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_import_note"
                android:text="@string/hongguo_login_import_note"
                android:textSize="@dimen/px24"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="@dimen/px12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_import"
                android:text="@string/hongguo_login_import"
                android:textSize="@dimen/px28"
                android:textColor="@color/hongguo_neutral_btn_text"
                android:background="@drawable/bg_hongguo_btn_primary"
                android:layout_marginTop="@dimen/px18"
                android:layout_width="match_parent"
                android:layout_height="@dimen/px64"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_login"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="@dimen/px60"
            android:layout_height="@dimen/px64"/>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_login_privacy"
        android:text="@string/hongguo_login_privacy"
        android:textSize="@dimen/px24"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:layout_marginTop="@dimen/px16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_login_privacy_sub"
        android:text="@string/hongguo_login_privacy_sub"
        android:textSize="@dimen/px22"
        android:textColor="@color/tab_normal"
        android:gravity="center"
        android:layout_marginTop="@dimen/px4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
