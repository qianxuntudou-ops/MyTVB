<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/px80"
        android:layout_marginTop="@dimen/px25"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:clipToPadding="false"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/underline"
        app:tabIndicatorColor="?attr/colorAccent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/px10"
        app:tabMode="scrollable"
        app:tabPaddingEnd="@dimen/px20"
        app:tabPaddingStart="@dimen/px20"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="?android:attr/textColorPrimary"
        app:tabTextAppearance="@style/TopPageTabText"
        app:layout_constraintEnd_toStartOf="@+id/button_hongguo_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/button_hongguo_search"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_input"
        android:addStatesFromChildren="true"
        android:focusable="true"
        android:clickable="true"
        android:paddingStart="@dimen/px20"
        android:paddingEnd="@dimen/px20"
        android:layout_marginEnd="@dimen/px30"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px60"
        app:layout_constraintBottom_toBottomOf="@+id/tabLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tabLayout">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_hongguo_search_icon"
            android:padding="@dimen/px6"
            android:layout_width="@dimen/px40"
            android:layout_height="@dimen/px40"
            app:srcCompat="@drawable/ic_search"
            app:tint="?android:attr/textColorSecondary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_hongguo_search_hint"
            android:text="@string/hongguo_search_hint"
            android:textSize="@dimen/px24"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="@dimen/px8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/px105"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 搜索覆盖层：胶囊点击时叠在六页签之上，返回键收起 -->
    <FrameLayout
        android:id="@+id/container_hongguo_search"
        android:background="?android:attr/windowBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 封面货架覆盖层（2026-11-11 重设计）：我的页四入口进入，返回键收起 -->
    <FrameLayout
        android:id="@+id/container_hongguo_shelf"
        android:background="?android:attr/windowBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
