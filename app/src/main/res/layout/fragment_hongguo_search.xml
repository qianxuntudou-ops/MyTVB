<?xml version="1.0" encoding="utf-8"?>
<com.mytvb.core.ui.focus.tv.FocusClampLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 输入行：主 APP 搜索框同款（bg_search_input 容器+图标），聚焦紫描边；左端退出钮收层 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_hongguo_search_exit"
            android:src="@drawable/ic_hongguo_back"
            app:tint="@color/textColor"
            android:background="@drawable/bg_hongguo_btn_outline"
            android:padding="@dimen/px10"
            android:contentDescription="@string/hongguo_back"
            android:layout_marginEnd="@dimen/px20"
            android:layout_width="@dimen/px76"
            android:layout_height="@dimen/px76"/>

        <LinearLayout
            android:id="@+id/layout_hongguo_search_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_input"
            android:addStatesFromChildren="true"
            android:paddingStart="@dimen/px24"
            android:paddingEnd="@dimen/px24"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/px76">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/px40"
                android:layout_height="@dimen/px40"
                android:layout_marginEnd="@dimen/px16"
                android:contentDescription="@string/search"
                app:srcCompat="@drawable/ic_search"
                app:tint="?android:attr/textColorSecondary"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_hongguo_keyword"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:hint="@string/hongguo_search_hint"
                android:textSize="@dimen/px30"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textColor="?android:attr/textColorPrimary"
                android:padding="0dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_hongguo_search_go"
            android:text="@string/hongguo_search_hint"
            android:textSize="@dimen/px28"
            android:textColor="@color/white"
            android:background="@drawable/bg_hongguo_btn_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="@dimen/px20"
            android:paddingStart="@dimen/px40"
            android:paddingEnd="@dimen/px40"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px70"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 发现态：搜索历史 + 猜你想搜 + 短剧/漫剧热搜榜 -->
        <ScrollView
            android:id="@+id/scroll_hongguo_discover"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="@dimen/px30"
                android:paddingEnd="@dimen/px30"
                android:paddingTop="@dimen/px24"
                android:paddingBottom="@dimen/px30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 搜索历史 -->
                <LinearLayout
                    android:id="@+id/section_hongguo_history"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:text="@string/hongguo_search_history"
                            android:textSize="@dimen/px30"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/button_hongguo_history_clear"
                            android:text="@string/hongguo_search_clear_history"
                            android:textSize="@dimen/px24"
                            android:textColor="@color/grey"
                            android:background="@drawable/button_common"
                            android:focusable="true"
                            android:clickable="true"
                            android:gravity="center"
                            android:paddingStart="@dimen/px28"
                            android:paddingEnd="@dimen/px28"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/px56"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_hongguo_history"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/px16"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>

                <!-- 猜你想搜 -->
                <LinearLayout
                    android:id="@+id/section_hongguo_guess"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/px24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:text="@string/hongguo_search_guess"
                        android:textSize="@dimen/px30"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_hongguo_guess"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/px16"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>

                <!-- 短剧/漫剧热搜榜（两列并排；空榜列整列隐藏，官方口径） -->
                <LinearLayout
                    android:id="@+id/section_hongguo_board"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/px24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/board_col_short"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:text="@string/hongguo_board_short"
                            android:textSize="@dimen/px30"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_hongguo_board_short"
                            android:paddingTop="@dimen/px16"
                            android:layout_marginEnd="@dimen/px12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/board_col_comic"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:text="@string/hongguo_board_comic"
                            android:textSize="@dimen/px30"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginStart="@dimen/px12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_hongguo_board_comic"
                            android:paddingTop="@dimen/px16"
                            android:layout_marginStart="@dimen/px12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 联想态：搜索推荐词竖排行 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_hongguo_suggest"
            android:visibility="gone"
            android:paddingStart="@dimen/px30"
            android:paddingEnd="@dimen/px30"
            android:paddingTop="@dimen/px16"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <!-- 结果态：B 站统一卡片网格 -->
        <FrameLayout
            android:id="@+id/container_hongguo_result"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_hongguo_results"
                android:clipToPadding="false"
                android:padding="@dimen/px20"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_hongguo_search_empty"
                android:text="@string/hongguo_search_no_result"
                android:textSize="@dimen/px30"
                android:textColor="@color/grey"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

            <!-- B 站同款 load_data.gif 帧动画（ onViewCreated 挂载；裸 ProgressBar 在电视 ROM 动画缩放=0 下不转） -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/progress_hongguo_search"
                android:contentDescription="@string/loading"
                android:layout_gravity="center"
                android:layout_width="@dimen/px50"
                android:layout_height="@dimen/px50"
                android:visibility="gone"/>
        </FrameLayout>
    </FrameLayout>
</com.mytvb.core.ui.focus.tv.FocusClampLinearLayout>
