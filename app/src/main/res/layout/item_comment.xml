<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/click_view"
    android:orientation="vertical"
    android:background="@drawable/cell_background"
    android:padding="@dimen/px20"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <!-- 用户行：头像 + 名称/Lv/UP + 时间/点赞 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- 头像 + 头像框(pendant) + 大会员角标；外框 px80（pendant 图框环仅占画布外圈~82%，需放大到内径>头像），头像 px60 与右侧两行文字等高（官方比例） -->
        <FrameLayout
            android:layout_width="@dimen/px80"
            android:layout_height="@dimen/px80">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_avatar"
                android:layout_gravity="center"
                android:layout_width="@dimen/px60"
                android:layout_height="@dimen/px60"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_avatar_pendant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>
            <!-- 粉丝勋章团徽（官方：佩戴粉丝团的用户头像左下角挂团徽；无团徽图时退化为粉丝牌配色圆点） -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_fan_medal"
                android:layout_width="@dimen/px24"
                android:layout_height="@dimen/px24"
                android:layout_gravity="bottom|start"
                android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tv_vip_badge"
                android:src="@drawable/ic_comment_vip_badge"
                android:layout_width="@dimen/px22"
                android:layout_height="@dimen/px22"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="@dimen/px10"
                android:layout_marginEnd="@dimen/px13"
                android:visibility="gone"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/px5">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/px24"
                    android:textStyle="bold"
                    android:textColor="@color/textColor"
                    android:ellipsize="end"
                    android:id="@+id/tv_user"
                    android:maxLines="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.mytvb.feature.player.comment.VideoCommentLevelView
                    android:id="@+id/tv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/px18"
                    android:layout_marginStart="@dimen/px10"
                    android:focusable="false"
                    android:visibility="gone"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/px16"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="UP"
                    android:id="@+id/tv_up_badge"
                    android:background="@drawable/bg_comment_up_badge"
                    android:paddingStart="@dimen/px8"
                    android:paddingEnd="@dimen/px8"
                    android:paddingTop="@dimen/px2"
                    android:paddingBottom="@dimen/px2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/px10"
                    android:visibility="gone"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/px6">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/px18"
                    android:textColor="@color/subTextColor"
                    android:id="@+id/tv_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <!-- 点赞组独立于文字块，在用户行右端与头像垂直居中（官方比例） -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px10">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_like"
                android:tint="@color/subTextColor"
                android:layout_width="@dimen/px28"
                android:layout_height="@dimen/px28"
                android:src="@drawable/ic_like"
                android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/px22"
                android:textColor="@color/textColor"
                android:id="@+id/tv_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/px6"
                android:visibility="gone"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <!-- 正文（大表情 ImageSpan 渲染，默认 6 行省略）；正文/图片/回复均与用户名左对齐（头像 70+15 缩进） -->
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/px24"
        android:textColor="@color/textColor"
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px85"
        android:layout_marginTop="@dimen/px12"
        android:maxLines="6"
        android:ellipsize="end"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/px20"
        android:textColor="@color/biliBlue"
        android:id="@+id/tv_expand"
        android:text="@string/player_comment_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px85"
        android:layout_marginTop="@dimen/px6"
        android:visibility="gone"/>
    <!-- 图片评论缩略图（最多 3 张，触摸点击开查看器；焦点模式走整卡点击） -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/row_pictures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px85"
        android:layout_marginTop="@dimen/px12"
        android:visibility="gone">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_picture_1"
            android:scaleType="centerCrop"
            android:layout_width="@dimen/px200"
            android:layout_height="@dimen/px150"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_picture_2"
            android:scaleType="centerCrop"
            android:layout_width="@dimen/px200"
            android:layout_height="@dimen/px150"
            android:layout_marginStart="@dimen/px15"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_picture_3"
            android:scaleType="centerCrop"
            android:layout_width="@dimen/px200"
            android:layout_height="@dimen/px150"
            android:layout_marginStart="@dimen/px15"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <!-- UP主觉得很赞（官方：灰底胶囊，UP 主点过赞的评论显示） -->
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/px18"
        android:textColor="@color/subTextColor"
        android:id="@+id/tv_up_liked"
        android:background="@drawable/bg_comment_up_liked"
        android:paddingStart="@dimen/px10"
        android:paddingEnd="@dimen/px10"
        android:paddingTop="@dimen/px2"
        android:paddingBottom="@dimen/px2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px85"
        android:layout_marginTop="@dimen/px10"
        android:text="@string/player_comment_up_liked"
        android:visibility="gone"/>
    <!-- 回复预览（楼中楼主两楼，用户名蓝色高亮） -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/row_reply_preview"
        android:background="@drawable/bg_comment_reply_preview"
        android:padding="@dimen/px15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px85"
        android:layout_marginTop="@dimen/px12"
        android:visibility="gone">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px20"
            android:textColor="@color/subTextColor"
            android:ellipsize="end"
            android:id="@+id/tv_reply_preview_1"
            android:maxLines="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px20"
            android:textColor="@color/subTextColor"
            android:ellipsize="end"
            android:id="@+id/tv_reply_preview_2"
            android:maxLines="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px6"
            android:visibility="gone"/>
        <!-- 查看全部 N 条回复（框内最后一行，对齐 B 站样式） -->
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px20"
            android:textColor="@color/biliBlue"
            android:drawableEnd="@drawable/ic_comment_reply_arrow"
            android:drawableTint="@color/biliBlue"
            android:drawablePadding="@dimen/px4"
            android:gravity="center_vertical"
            android:id="@+id/tv_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px10"
            android:visibility="gone"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
