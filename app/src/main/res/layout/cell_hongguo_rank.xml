<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/tab_round_background"
    android:layout_marginStart="@dimen/px20"
    android:layout_marginEnd="@dimen/px20"
    android:layout_marginTop="@dimen/px6"
    android:layout_marginBottom="@dimen/px6"
    android:padding="@dimen/px12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_rank"
        android:textSize="@dimen/px40"
        android:textStyle="bold"
        android:layout_marginEnd="@dimen/px16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_cover"
        android:scaleType="centerCrop"
        android:layout_width="@dimen/px225"
        android:layout_height="@dimen/px120"
        android:background="@color/black"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="@dimen/px16"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            android:textSize="@dimen/px26"
            android:textColor="?android:attr/textColorPrimary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_meta"
            android:textSize="@dimen/px20"
            android:textColor="@color/grey"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/px4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_heat"
            android:textSize="@dimen/px20"
            android:textColor="#FFB28F"
            android:layout_marginTop="@dimen/px4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
