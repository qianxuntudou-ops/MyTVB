<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/click_view"
    android:background="@drawable/cell_background"
    android:padding="@dimen/px10"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="@dimen/px240"
        android:layout_height="@dimen/px147">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/default_video"/>
        <!-- 封面底部信息条：样式与首页推荐卡片一致（播放量/弹幕/时长），用标准 View 避免 canvas 叠印。
             px200 封面装不下三组内容的原始尺寸（时长会被右缘裁尾），故图标/字号紧凑一档，
             且时长放独立右对齐位不参与压缩：溢出只裁左侧弹幕尾部，时长永远完整。 -->
        <LinearLayout
            android:id="@+id/cover_meta_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_cover_meta_gradient"
            android:paddingStart="@dimen/px6"
            android:paddingTop="@dimen/px44"
            android:paddingBottom="@dimen/px10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/group_play"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/px20"
                        android:layout_height="@dimen/px20"
                        android:src="@drawable/ic_video_play_count"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_play_count"
                        android:textSize="@dimen/px18"
                        android:textColor="@color/textColor"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/px4"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/group_danmaku"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/px6">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/px20"
                        android:layout_height="@dimen/px20"
                        android:src="@drawable/ic_video_danmaku"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_danmaku"
                        android:textSize="@dimen/px18"
                        android:textColor="@color/textColor"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/px4"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_duration"
                android:textSize="@dimen/px18"
                android:textColor="@color/textColor"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/px10"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/px20">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- 双行标题+焦点滚动（issue#140）：序号与播放GIF并入标题文本流
                 （[GIF]165. 标题），标题区吃满整行不再被序号/图标列挤压 -->
            <com.mytvb.core.ui.view.TwoLineScrollTextView
                android:textSize="@dimen/px30"
                android:textColor="@color/textColor"
                android:ellipsize="end"
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/px10"
                android:maxLines="2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px26"
            android:textColor="@color/subTextColor"
            android:id="@+id/text_pub_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px10"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
