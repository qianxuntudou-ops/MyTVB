<?xml version="1.0" encoding="utf-8"?>
<!-- 红果详情选集格：外层格子承接焦点（四态背景由 bg_hongguo_episode 驱动），
     右上角可挂「上次观看」角标（照 CCTV 影视详情页 cell 做法：badge_background
     粉底 + 右上/左下圆角、px18 字、贴角无缝隙）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_episode_root"
    android:background="@drawable/bg_hongguo_episode"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/px68">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_hongguo_episode"
        android:gravity="center"
        android:textSize="@dimen/px26"
        android:textColor="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_last_watched"
        android:text="@string/cctv_vod_last_watched"
        android:textSize="@dimen/px18"
        android:textColor="@color/textColor"
        android:background="@drawable/badge_background"
        android:paddingStart="@dimen/px7"
        android:paddingTop="@dimen/px3"
        android:paddingEnd="@dimen/px7"
        android:paddingBottom="@dimen/px3"
        android:visibility="gone"
        android:layout_gravity="top|end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
