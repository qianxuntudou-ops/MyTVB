<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页内容 Tab 栏：「合集·推荐 / 推荐」与「评论 N」切换（对齐官方手机端简介/评论 tab 结构） -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/px30"
    android:paddingTop="@dimen/px20">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/tab_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tab_item_round_background"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/px10"
        android:paddingEnd="@dimen/px10"
        android:paddingBottom="@dimen/px10">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_tab_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/px32" />

        <View
            android:id="@+id/indicator_content"
            android:layout_width="@dimen/px56"
            android:layout_height="@dimen/px6"
            android:layout_marginTop="@dimen/px8"
            android:background="@drawable/bg_tab_indicator" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/tab_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px70"
        android:background="@drawable/tab_item_round_background"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/px10"
        android:paddingEnd="@dimen/px10"
        android:paddingBottom="@dimen/px10">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_tab_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_comment_title"
                android:textSize="@dimen/px32" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_tab_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/px10"
                android:textSize="@dimen/px32" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:id="@+id/indicator_comment"
            android:layout_width="@dimen/px56"
            android:layout_height="@dimen/px6"
            android:layout_marginTop="@dimen/px8"
            android:background="@drawable/bg_tab_indicator" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
