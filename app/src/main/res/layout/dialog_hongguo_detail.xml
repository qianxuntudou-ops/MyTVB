<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/dialog_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/px500"
    android:padding="@dimen/px30">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_cover"
        android:scaleType="centerCrop"
        android:layout_width="@dimen/px300"
        android:layout_height="@dimen/px400"
        android:background="@color/black"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="@dimen/px24"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            android:textSize="@dimen/px34"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_meta"
            android:textSize="@dimen/px22"
            android:textColor="@color/grey"
            android:layout_marginTop="@dimen/px8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_intro"
            android:textSize="@dimen/px22"
            android:textColor="@color/grey"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/px12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/px16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_play"
                android:text="@string/hongguo_play_continue"
                android:textSize="@dimen/px26"
                android:textColor="@color/white"
                android:background="@drawable/hongguo_btn_play"
                android:minWidth="@dimen/px225"
                android:paddingStart="@dimen/px30"
                android:paddingEnd="@dimen/px30"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/px64"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_favorite"
                android:text="@string/hongguo_favorite"
                android:textSize="@dimen/px26"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/tab_round_background"
                android:layout_marginStart="@dimen/px16"
                android:paddingStart="@dimen/px30"
                android:paddingEnd="@dimen/px30"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/px64"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_episode_header"
            android:textSize="@dimen/px22"
            android:textColor="@color/grey"
            android:layout_marginTop="@dimen/px16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_episodes"
            android:layout_marginTop="@dimen/px8"
            android:nestedScrollingEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
