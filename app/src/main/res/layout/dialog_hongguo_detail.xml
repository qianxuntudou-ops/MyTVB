<?xml version="1.0" encoding="utf-8"?>
<!-- 红果详情弹窗：左海报 + 右信息/三按钮 + 选集区（分页 chip + 网格）。
     控件语言对齐选集格（bg_hongguo_episode 同款状态语言）：动作钮
     （继续播放/收藏共用）=bg_hongguo_btn_detail，常态=#14FFFFFF 淡灰底、
     按下=colorPrimary、聚焦=colorControlHighlight、已收藏=tabBarHighlight 实底。
     焦点链：按钮行 ↓ 选集区；选集/分页顶行 ↑ 按钮行；BACK 关弹窗。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:clickable="true"
    android:paddingStart="@dimen/px35"
    android:paddingTop="@dimen/px30"
    android:paddingEnd="@dimen/px35"
    android:paddingBottom="@dimen/px30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 头部：海报 + 信息 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/default_video"
            android:layout_width="@dimen/px240"
            android:layout_height="@dimen/px320"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="@dimen/px30"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/px320">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_title"
                android:textSize="@dimen/px38"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- 评分（强调色）+ 类型标签（灰）同一行：评分无数据时整行只剩标签 -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/px10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_score"
                    android:textSize="@dimen/px30"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAccent"
                    android:layout_marginEnd="@dimen/px16"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_tags"
                    android:textSize="@dimen/px24"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_intro"
                android:textSize="@dimen/px26"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="@dimen/px6"
                android:layout_marginTop="@dimen/px12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_meta"
                android:textSize="@dimen/px24"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/px12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 按钮行：继续播放 / 收藏，与选集格完全同语言（bg_hongguo_btn_detail）：
         常态淡灰底 / 聚焦 colorControlHighlight / 点击 colorPrimary，
         收藏钮选中=已收藏 tabBarHighlight 实底；首版主钮灰底次钮白描边
         在深色弹窗上只剩白线扎眼（2026-11-15 用户拍板与选集格统一） -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/px24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 继续播放：ic_play intrinsic 300px 巨大，用定尺寸 iconView 组合而非 drawableStart -->
        <LinearLayout
            android:id="@+id/button_play"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_hongguo_btn_detail"
            android:focusable="true"
            android:clickable="true"
            android:addStatesFromChildren="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/px76">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/px30"
                android:layout_height="@dimen/px30"
                android:layout_marginEnd="@dimen/px12"
                android:contentDescription="@string/hongguo_play_continue"
                app:srcCompat="@drawable/ic_play"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_button_play"
                android:text="@string/hongguo_play_continue"
                android:textSize="@dimen/px28"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_favorite"
            android:textSize="@dimen/px28"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@drawable/bg_hongguo_btn_detail"
            android:drawableStart="@drawable/ic_favorite"
            android:drawablePadding="@dimen/px12"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginStart="@dimen/px20"
            android:paddingStart="@dimen/px20"
            android:paddingEnd="@dimen/px20"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/px76"/>
    </LinearLayout>

    <!-- 选集标题行：左「选集+正在看」右「当前页范围」 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/px28"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:text="@string/choose_episode"
            android:textSize="@dimen/px30"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_watching"
            android:textSize="@dimen/px24"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="@dimen/px20"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_page_range"
            android:textSize="@dimen/px24"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 分页 chip 行（1-20 / 21-40 / …），选集不足一页时整行隐藏 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_page_chips"
        android:orientation="horizontal"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:paddingTop="@dimen/px16"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    <!-- 选集网格（8 列，页内滚动） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_episodes"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/px8"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
