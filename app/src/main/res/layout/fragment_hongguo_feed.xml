<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 筛选 chip 行（仅在线 feed 模式显示，selector_rows 就绪后可见） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_filters"
        android:orientation="horizontal"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:paddingTop="@dimen/px10"
        android:paddingBottom="@dimen/px10"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_feed"
            android:clipToPadding="false"
            android:paddingStart="@dimen/px20"
            android:paddingEnd="@dimen/px20"
            android:paddingBottom="@dimen/px20"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_empty"
            android:text="@string/hongguo_empty"
            android:textSize="@dimen/px28"
            android:textColor="@color/grey"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="@dimen/px60"
            android:layout_height="@dimen/px60"/>
    </FrameLayout>
</LinearLayout>
